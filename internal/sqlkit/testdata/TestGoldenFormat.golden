-- pg: create function f() returns int as $$ select 1 $$ language sql
create function f () returns int as $$ select 1 $$ language sql

-- pg: select E'a\'b', x::int, count(*) filter (where y > 0) from t where id = $1 -- the one
group by x
select
  E'a\'b',
  x::int,
  count(*) filter (
    where
      y > 0
  )
from
  t
where
  id = $1 -- the one
group by
  x

-- pg: /* two */ update t set a = 1 where b in (select b from u); delete from t
/* two */
update t
set
  a = 1
where
  b in (
    select
      b
    from
      u
  );

delete from t

-- mysql: select `a b`, c from `t` # a comment
where d = 'x' limit 5, 10
select
  `a b`,
  c
from
  `t` # a comment
where
  d = 'x'
limit
  5, 10

-- mysql: insert into t (a) values (1), (2) on duplicate key update a = values(a)
insert into
  t (a)
values
  (1),
  (2)
on duplicate key update
  a = values(a)

-- sqlite: select "a b", `c`, x -> 'k' from t where d = ?1 order by 1 limit 5 offset 10
select
  "a b",
  `c`,
  x -> 'k'
from
  t
where
  d = ?1
order by
  1
limit
  5
offset
  10

-- duckdb: select [1, 2] l, {'k': 1} s, x::int from "t" where d is not distinct from $1 -- c
qualify row_number() over () = 1 limit 5
select
  [1, 2] l,
  {'k': 1} s,
  x::int
from
  "t"
where
  d is not distinct from $1 -- c
qualify
  row_number() over () = 1
limit
  5

-- upper, types too, not functions; tab_width 4
SELECT
    a,
    now()
FROM
    t;

CREATE TABLE t (a INT)
